# Database
DATABASE_URL=sqlite:///fin_daily_report.db

# Polygon EOD grouped bars (two calls per daily run)
MARKET_PROVIDER=polygon
POLYGON_API_KEY=your_polygon_api_key
SEC_USER_AGENT=YourAppName your.email@example.com
REQUEST_TIMEOUT_SECONDS=30

# Movers query-time quality filters
MOVER_FILTER_ENABLED=true
MIN_LAST_PRICE=1.0
MIN_DAY_VOLUME=100000
MOVERS_LIMIT=10

# Ingestion scheduler defaults
INGEST_INTERVAL_MINUTES=5

# Industry labeling (AI)
INDUSTRY_LLM_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3-flash

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
