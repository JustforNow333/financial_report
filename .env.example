# Database
DATABASE_URL=sqlite:///fin_daily_report.db

# Market snapshot provider
MARKET_PROVIDER=polygon
POLYGON_API_KEY=your_polygon_api_key
POLYGON_BASE_URL=https://api.polygon.io
REQUEST_TIMEOUT_SECONDS=30

# Movers query-time quality filters
MOVER_FILTER_ENABLED=true
MIN_LAST_PRICE=1.0
MIN_DAY_VOLUME=100000
MOVERS_LIMIT=10

# Ingestion scheduler defaults
INGEST_INTERVAL_MINUTES=5

# Industry labeling (AI)
INDUSTRY_LLM_ENABLED=true
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
